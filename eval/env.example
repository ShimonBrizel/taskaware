# Copy this file to eval/.env (already git-ignored) and fill ONE of the two options.
# Use a dedicated eval account with no push token, so your phone is not notified per call.

# Option A: login credentials of the eval account
EVAL_USERNAME=  
EVAL_PASSWORD=

# Option B: an existing API token instead
# TASKAWARE_TOKEN=

# Optional: point at a local server instead of Render
# TASKAWARE_BASE_URL=http://127.0.0.1:8000
